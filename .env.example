# In development, copy this file to .env.local and set the appropriate values.
# cp .env.example .env.local

# Public site URL used for canonical links, sitemap, OG metadata.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Google Analytics 4 measurement ID. Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=""

# Google Tag Manager container ID. Format: GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=""
